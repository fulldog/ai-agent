[Unit]
Description=AI Agent (git pull + docker compose full stack)
Documentation=https://github.com/fulldog/ai-agent
# 使用 HTTPS clone：https://github.com/fulldog/ai-agent.git
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 改成服务器上的实际克隆路径；建议与 git clone 的用户一致，以便读取 HTTPS 凭证
# User=deploy
WorkingDirectory=/opt/ai-agent
Environment=DEPLOY_BRANCH=main
Environment=DEPLOY_REMOTE=origin
ExecStart=/opt/ai-agent/deploy/docker/update-and-start.sh
ExecStop=/bin/bash -c 'cd /opt/ai-agent && docker compose -f docker-compose.yml -f docker-compose.db.yml stop 2>/dev/null; docker compose -f docker-compose.yml stop'
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
