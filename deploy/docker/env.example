# 复制为项目根目录 .env 后填写：cp deploy/docker/env.example .env
# docker compose 会自动读取 .env

# ---------- 应用 ----------
API_KEYS=change-me-api-key
# 逗号分隔多个 key，例如：key1,key2

# LLM（至少填一个常用厂商）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=

# ---------- 数据库（与 compose 中 db 服务一致）----------
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent_dev
POSTGRES_DB=ai_agent
# 对外映射端口（宿主机）
POSTGRES_PORT=5432

# 应用连接串（容器内主机名必须是服务名 db）
DATABASE_URL=postgres://ai_agent:ai_agent_dev@db:5432/ai_agent?sslmode=disable

# ---------- 端口 ----------
APP_PORT=18090

# ---------- 可选：Go 模块代理（构建用，国内建议保留）----------
GOPROXY=https://goproxy.cn,direct
