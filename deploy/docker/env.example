# 复制为项目根目录 .env 后填写：cp deploy/docker/env.example .env
# docker compose / update-and-start.sh 会读取本文件

# ---------- 应用 ----------
API_KEYS=change-me-api-key
# 逗号分隔多个 key，例如：key1,key2

# LLM（至少填一个常用厂商）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=

# ---------- 数据库策略 ----------
# auto     = 宿主机 POSTGRES_PORT（默认 5432）已有服务则复用，否则启动内置 PG+pgvector
# external = 强制复用外部库（必须配置 EXTERNAL_DATABASE_URL）
# embedded = 强制启动本项目 docker-compose.db.yml 内的库
DB_MODE=auto

# 宿主机探测 / 内置库映射端口
POSTGRES_PORT=5432

# ----- 复用已有 Postgres（DB_MODE=auto 且 5432 已被占用，或 DB_MODE=external）-----
# 用「宿主机视角」填写（127.0.0.1）。脚本会：
#   1) 检查能否连接、是否已装 pgvector，并 CREATE EXTENSION IF NOT EXISTS vector
#   2) 自动把应用容器连接改成 host.docker.internal
# EXTERNAL_DATABASE_URL=postgres://postgres:你的密码@127.0.0.1:5432/ai_agent?sslmode=disable

# ----- 仅内置库时使用（DB_MODE=embedded，或 auto 且 5432 空闲）-----
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent_dev
POSTGRES_DB=ai_agent
# 应用容器连内置库（主机名必须是 db）；一般可不动，由脚本生成
DATABASE_URL=postgres://ai_agent:ai_agent_dev@db:5432/ai_agent?sslmode=disable

# ---------- 端口 ----------
APP_PORT=18090

# ---------- 可选：Go 模块代理（构建用，国内建议保留）----------
GOPROXY=https://goproxy.cn,direct
